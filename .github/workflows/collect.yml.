name: collect-new-pools
on:
  schedule:
    - cron: "7 * * * *"
  workflow_dispatch: {}
concurrency:
  group: memebot-data
  cancel-in-progress: false
permissions:
  contents: write
jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: List new pools
        run: python history_fetch.py discover --out data/pools_seen.csv --minutes 0 --pages 10 --preset public
      - name: Save to the repo
        run: |
          git config user.name "collector"
          git config user.email "collector@users.noreply.github.com"
          git add data
          git diff --cached --quiet || (git commit -m "pools $(date -u +%FT%TZ)" && git pull --rebase && git push)
